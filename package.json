{
  "name": "webhook-failure-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Reproduce webhook failures and inspect declared business outcomes on disposable test applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "webhook-lab": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:ui": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "db:up": "bash scripts/database.sh up",
    "db:down": "bash scripts/database.sh down",
    "test:built": "node --test dist/test/integration/journey.test.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
